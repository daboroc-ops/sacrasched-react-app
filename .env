# ── App ──────────────────────────────────────────────
VITE_APP_NAME=SacraSched

# ── API ──────────────────────────────────────────────
# Vite proxies /api → http://127.0.0.1:3000 (see vite.config.js)
VITE_API_BASE=/api

# -- Cloudflare Turnstile --
# Site key from the same Turnstile widget as TURNSTILE_SECRET_KEY.
# Unset = no captcha is rendered (and the API skips the check).
# Cloudflare test key that always passes: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEmlT9jNM4cibY8F

# ── Public hosting ───────────────────────────────────
# Hosts the dev server answers to when exposed through a tunnel.
# vite.config.js turns this into ".sacrasched.online", covering
# the apex and every parish subdomain.
PUBLIC_HOST=sacrasched.online
